# Copy this file to .env.local for local development. Never commit real keys.
# On Vercel, add these under Project Settings -> Environment Variables instead.

# Required: your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq chat model ID. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=
